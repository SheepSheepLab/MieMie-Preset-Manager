{
  "name": "miemie-preset-manager",
  "version": "0.2.2",
  "private": true,
  "description": "Native SillyTavern preset manager delivered as a Tavern Helper script",
  "scripts": {
    "build": "node build.cjs",
    "test": "node build.cjs --test",
    "check": "tsc -p tsconfig.json",
    "test:browser": "node tests/browser-check.cjs && node tests/mobile-responsive.cjs",
    "test:ui-performance": "node tests/reorder-browser.cjs",
    "test:save-performance": "node tests/save-benchmark.cjs",
    "test:presentation": "node tests/presentation-browser.cjs",
    "test:package-v1": "node --test tests/package-v1-build.cjs tests/fixtures/hub-package-v1/tests/package-manager.test.mjs",
    "test:binding-browser": "node tests/binding-browser.cjs",
    "test:parameters-browser": "node tests/parameters-browser.cjs",
    "test:parameter-motion": "node tests/parameter-motion-browser.cjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "webpack": "5.108.4",
    "ts-loader": "9.6.2",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "GPL-3.0-or-later",
  "author": "SheepSheep",
  "repository": {
    "type": "git",
    "url": "https://github.com/SheepSheepLab/MieMie-Preset-Manager.git"
  }
}
