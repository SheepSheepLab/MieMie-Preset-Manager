{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": [],
    "resolveJsonModule": true, "allowSyntheticDefaultImports": true,
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitReturns": true
  },
  "include": ["*.ts"], "exclude": ["tests", "*.test.ts", ".test-build", "delivery"]
}
